# ---- Base de datos (Supabase: proyecto NUEVO, separado del de vestuarios) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave "secret" (o service_role). NUNCA va en el navegador ni en GitHub.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Nombre del bucket PRIVADO donde se guardan las imágenes de comprobantes
SUPABASE_BUCKET=comprobantes-entradas

# ---- Acceso de Jose (solo Jose vende; los compradores solo suben su comprobante en /pagar) ----
ADMIN_USUARIO=jose
ADMIN_CLAVE=pon-aqui-una-clave-larga-y-unica
# Cualquier texto largo y al azar. Sin esto, cada reinicio del servidor cierra la sesión.
SESION_SECRETO=pon-aqui-30-o-mas-caracteres-al-azar

# ---- Lector de comprobantes (Google Vision) ----
GOOGLE_VISION_API_KEY=AIza...

# ---- Cuenta a la que TODOS deben transferir (a nombre de Jose) ----
# Se muestra en la página de pago y se usa para validar cada comprobante.
# Si se dejan vacías, NO se valida a qué cuenta fue la transferencia.
CUENTA_DESTINO=CR11 0102 0000 9606 5818 55
TITULAR_DESTINO=Jose Rafael Bolaños Mora
BANCO_DESTINO=BAC

# ---- Opcionales ----
# Después de esta fecha (AAAA-MM-DD) el servidor borra solo las imágenes de comprobantes.
FECHA_BORRADO=
# Respaldo opcional si el OCR no encuentra la referencia
ANTHROPIC_API_KEY=
# true = imprime en el log el texto que leyó Vision (solo para depurar; muestra datos de la gente)
DEBUG_OCR=false
